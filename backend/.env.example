# Database (Neon Free - SSL obrigatório)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie (omitir COOKIE_DOMAIN para production same-origin)
COOKIE_SECURE=false

# CORS
FRONTEND_URL="http://localhost:5173"

# Server
PORT=3001

# Seed (primeiro usuário MASTER)
SEED_MASTER_EMAIL="master@docbuilder.com"
SEED_MASTER_PASSWORD="Master@123"
SEED_MASTER_NAME="Master Admin"
