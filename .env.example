# Database (Neon Free - https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&schema=public"

# JWT
JWT_SECRET="generate-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie (omitir COOKIE_DOMAIN para same-origin como Vercel)
COOKIE_SECURE=true

# CORS (same-origin na Vercel, só precisa se front/API forem separados)
FRONTEND_URL="https://seu-site.vercel.app"

# Seed (opcional - usado automaticamente no build da Vercel)
SEED_MASTER_EMAIL="master@docbuilder.com"
SEED_MASTER_PASSWORD="Master@123"
SEED_MASTER_NAME="Master Admin"
